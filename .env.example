# ============================================
# KOPIRATI u .env.local i popuniti vrednosti
# ============================================

# URL sajta (bez trailing slash) - kanonski domen, isti kao u Google Search Console
NEXT_PUBLIC_SITE_URL=https://majstor-bg.rs

# Naziv sajta
NEXT_PUBLIC_SITE_NAME=HausMajstor Beograd

# Google Search Console verifikacija (sadrzaj content atributa iz "HTML tag" metode)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Mailjet - slanje mejlova sa kontakt forme (https://app.mailjet.com/account/apikeys)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
SITE_MAIL_SENDER=noreply@example.com
SITE_MAIL_RECEIVER=hitneintervencijemilan@gmail.com

# Google Analytics (opciono)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
